# Copy this file to .env and pick ONE provider block.
# Every provider below speaks the same "OpenAI-compatible" HTTP API,
# so switching providers only means changing these three values.

# --- Option A: Google Gemini (free tier; get a free key at https://aistudio.google.com/apikey)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=paste-your-key-here
LLM_MODEL=gemini-2.5-flash

# --- Option B: Groq (free tier, very fast; key at https://console.groq.com/keys)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=paste-your-key-here
# LLM_MODEL=openai/gpt-oss-20b

# --- Option C: Ollama (fully local and free; install from https://ollama.com, then run: ollama pull llama3.2)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.2

# Model names change over time. Run "npm run models" to see what your provider offers right now.

PORT=3001
# Max characters per chunk sent to the LLM (roughly 4 characters per token).
CHUNK_SIZE=12000
