# Copy this file to .env.
# Every provider below speaks the same "OpenAI-compatible" HTTP API,
# so a provider is just three values: base URL, API key, model name.

# ============================================================================
# 1. DEFAULT MODEL (required): used for normal-sized documents.
#    Pick ONE block. Groq is the recommended default: it's very fast.
# ============================================================================

# --- Groq (free tier, very fast; key at https://console.groq.com/keys)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=paste-your-key-here
LLM_MODEL=openai/gpt-oss-20b
# For reasoning models: how much they think before answering (low | medium | high).
# "low" is plenty for summaries; on the default, gpt-oss sometimes thought so long it
# returned an empty answer. Remove this line for models that don't support it.
LLM_REASONING_EFFORT=low

# --- Google Gemini (free tier; key at https://aistudio.google.com/apikey)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=paste-your-key-here
# LLM_MODEL=gemini-flash-latest

# --- Ollama (fully local and free; install from https://ollama.com, then run: ollama pull llama3.2)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.2

# Max characters per request to the default model (roughly 4 characters per token).
# Documents longer than this go to the LARGE model below if one is set; otherwise they're
# split into chunks of this size and summarized piece by piece ("map-reduce").
CHUNK_SIZE=12000

# ============================================================================
# 2. LARGE MODEL (optional): used for documents longer than CHUNK_SIZE.
#    A model with a huge context window reads the whole document in ONE call,
#    instead of many small calls that hit the default model's rate limits.
#    If it fails (e.g. daily quota used up), the app falls back to the default model.
#    Leave these commented out to always use the default model.
# ============================================================================

# --- Google Gemini (free tier; key at https://aistudio.google.com/apikey)
# Note: on the free tier, Google may use your inputs to improve its products.
# LARGE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LARGE_LLM_API_KEY=paste-your-gemini-key-here
# "lite" models are much faster for summaries (a 7-page document took ~2.5s vs ~15-40s on regular Flash).
# Pinned versions get retired eventually: if you get a 404, run "npm run models -- large" and pick a newer one.
# LARGE_LLM_MODEL=gemini-3.5-flash-lite
# LARGE_LLM_REASONING_EFFORT=low

# Max characters per request to the large model (~100k tokens).
# LARGE_CHUNK_SIZE=400000

# ============================================================================
# 3. Q&A / RAG (optional): embeddings for searching inside the document.
#    Turns each passage into a vector so questions can find the right passages.
#    Uses the LARGE_LLM_* URL and key (Groq has no embeddings). Leave EMBEDDING_MODEL
#    unset to turn Q&A off; set EMBEDDING_BASE_URL / EMBEDDING_API_KEY to use another provider.
# ============================================================================

# EMBEDDING_MODEL=gemini-embedding-001
# 768 instead of the default 3072 numbers per vector: 4x smaller, nearly as precise.
# EMBEDDING_DIMENSIONS=768

# Model names change over time. To see what each provider offers right now:
#   npm run models            (default model's provider)
#   npm run models -- large   (large model's provider)

PORT=3001
