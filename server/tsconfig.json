{
  "compilerOptions": {
    "target": "ES2023",
    // NodeNext = follow Node's real module rules. That's why relative imports end in ".js":
    // they point at the compiled output file, even though the source file is ".ts".
    // package.json has "type": "commonjs", so tsc outputs CommonJS (require/module.exports).
    // We write `import` in the source, but the compiled JS works even without a
    // package.json next to it, which is how Vercel runs it (/var/task/index.js).
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src"]
}
